@model TravelAgencyProject.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<style>
    /* רקע לבן ונקי */
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .login-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* כרטיס אלגנטי עם צל רך מאוד */
    .login-card {
        border: none;
        border-radius: 16px;
        background-color: #ffffff;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
        padding: 40px;
        width: 100%;
        max-width: 420px;
        transition: transform 0.3s ease;
    }

        .login-card:hover {
            transform: translateY(-5px);
        }

    /* כותרת מינימליסטית */
    .login-title {
        color: #212529;
        font-weight: 700;
        font-size: 1.8rem;
        margin-bottom: 8px;
        text-align: center;
    }

    .login-subtitle {
        color: #6c757d;
        text-align: center;
        margin-bottom: 35px;
        font-size: 0.95rem;
    }

    /* עיצוב שדות הקלט */
    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #495057;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border-radius: 10px;
        padding: 12px 16px;
        border: 1px solid #dee2e6;
        background-color: #f8f9fa;
        transition: all 0.2s ease-in-out;
    }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #007bff;
            box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.1);
            outline: none;
        }

    /* כפתור כניסה מרשים */
    .btn-login {
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 14px;
        font-weight: 600;
        font-size: 1rem;
        width: 100%;
        margin-top: 10px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-login:hover {
            background-color: #0069d9;
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.25);
        }

    /* קישור להרשמה */
    .register-text {
        text-align: center;
        margin-top: 25px;
        font-size: 0.9rem;
        color: #6c757d;
    }

        .register-text a {
            color: #007bff;
            text-decoration: none;
            font-weight: 600;
        }

            .register-text a:hover {
                text-decoration: underline;
            }
</style>

<div class="login-wrapper">
    <div class="login-card">
        <h2 class="login-title">Sign In</h2>
        <p class="login-subtitle">Please enter your details to continue</p>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-uppercase">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="e.g. alex@travel.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label text-uppercase">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn-login">Login to Account</button>
        </form>

        <div class="register-text">
            Don't have an account? <a asp-action="Register">Create one now</a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}