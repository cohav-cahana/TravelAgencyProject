@model TravelAgencyProject.Models.User

@{
    ViewData["Title"] = "Personal Profile";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-dark text-white text-center py-4">
                    <i class="bi bi-person-badge fs-1"></i>
                    <h2 class="mt-2 fw-light">My Profile</h2>
                </div>
                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <p class="text-muted">Account Information</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold text-secondary">Full Name:</div>
                        <div class="col-sm-8 text-dark">@Model.FirstName @Model.LastName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold text-secondary">Email:</div>
                        <div class="col-sm-8 text-dark">@Model.Email</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold text-secondary">Account Status:</div>
                        <div class="col-sm-8">
                            @if (Model.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success border border-success">Active Account</span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger">Inactive</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-4 fw-bold text-secondary">Role:</div>
                        <div class="col-sm-8 text-dark">
                            @(Model.IsAdmin ? "Administrator" : "Standard Traveler")
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a asp-controller="Booking" asp-action="Index" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-luggage-fill me-2"></i>View My Bookings
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                            Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>