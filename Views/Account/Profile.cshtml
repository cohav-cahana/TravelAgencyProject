@model TravelAgencyProject.Models.User

@{
    ViewData["Title"] = "Personal Profile";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4 overflow-hidden">
                <div class="row g-0">

                    <div class="col-md-4 bg-primary text-white text-center d-flex flex-column align-items-center justify-content-center p-4">
                        <div class="mb-3">
                            <i class="bi bi-person-circle" style="font-size: 6rem;"></i>
                        </div>
                        <h3 class="fw-bold mb-1">@Model.FirstName @Model.LastName</h3>
                        <p class="badge bg-white text-primary rounded-pill px-3">
                            @(Model.IsAdmin ? "Administrator" : "Traveler")
                        </p>
                    </div>

                    <div class="col-md-8 bg-white p-5">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="text-secondary fw-bold mb-0">Account Information</h4>
                            <i class="bi bi-shield-check text-success fs-4"></i>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted small fw-bold">FULL NAME</div>
                            <div class="col-sm-8 fs-5">@Model.FirstName @Model.LastName</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted small fw-bold">EMAIL ADDRESS</div>
                            <div class="col-sm-8 fs-5">@Model.Email</div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-sm-4 text-muted small fw-bold">ACCOUNT STATUS</div>
                            <div class="col-sm-8">
                                @if (Model.IsActive)
                                {
                                <span class="text-success"><i class="bi bi-check-circle-fill"></i> Verified & Active</span>
                                }
                                else
                                {
                                <span class="text-danger"><i class="bi bi-x-circle-fill"></i> Inactive</span>
                                }
                            </div>
                        </div>

                        <hr class="my-4">

                        <h5 class="mb-3 text-secondary">Quick Actions</h5>
                        <div class="d-flex gap-3">
                            <a asp-controller="Booking" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-luggage-fill me-2"></i>My Bookings
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4">
                                <i class="bi bi-house-door me-2"></i>Home
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger rounded-pill px-4">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 p-3 bg-light rounded-3 border d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-primary me-3 fs-4"></i>
                <small class="text-muted">
                    If you need to update your personal information or change your password, please contact our support team.
                </small>
            </div>

        </div>
    </div>
</div>

<style>
    /* Custom hover effect for buttons */
    .btn-outline-primary:hover {
        transform: translateY(-2px);
        transition: all 0.3s;
    }

    /* Card shadow enhancement */
    .card {
        transition: box-shadow 0.3s ease-in-out;
    }
</style>