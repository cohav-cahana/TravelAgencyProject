@model IEnumerable<TravelAgencyProject.Models.Trip>

@{
    ViewData["Title"] = "Trip Gallery";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">Explore Our Trips</h1>
        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <a asp-action="Create" class="btn btn-success btn-lg">+ Add New Trip</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm hover-effect">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Destination" style="height: 200px; object-fit: cover;">

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title font-weight-bold">@item.Destination, @item.Country</h5>
                            <span class="badge bg-info text-dark">@item.Category</span>
                        </div>

                        <p class="card-text text-muted text-truncate">@item.Description</p>

                        <div class="mt-auto">
                            <hr />
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    @if (item.SalePrice != null)
                                    {
                                        <small class="text-muted text-decoration-line-through">$@item.Price</small>
                                        <span class="text-danger fw-bold fs-5">$@item.SalePrice</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold fs-5">$@item.Price</span>
                                    }
                                </div>

                                <a asp-action="Details" asp-route-id="@item.TripId" class="btn btn-outline-primary btn-sm">View Details</a>
                            </div>

                            @if (Context.Session.GetString("IsAdmin") == "true")
                            {
                                <div class="mt-2 text-end">
                                    <a asp-action="Edit" asp-route-id="@item.TripId" class="text-warning mx-1">Edit</a> |
                                    <a asp-action="Delete" asp-route-id="@item.TripId" class="text-danger mx-1">Delete</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-effect:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.2) !important;
    }
</style>