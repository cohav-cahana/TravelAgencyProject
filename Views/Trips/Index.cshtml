@model IEnumerable<TravelAgencyProject.Models.Trip>

@{
    ViewData["Title"] = "Trip Gallery";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 text-primary">Explore Our Trips</h1>
        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">+ Add New Trip</a>
        }
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-8">
            <form asp-action="Index" method="get" class="input-group input-group-lg shadow-sm">
                <input type="text" name="searchString" class="form-control border-primary"
                       placeholder="Search by destination, country, keywords, or package..."
                       value="@ViewData["CurrentFilter"]" />
                <button type="submit" class="btn btn-primary px-4">
                    🔍 Search
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center">Reset</a>
                }
            </form>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5">
                <h3 class="text-muted">No trips found matching your search.</h3>
                <a asp-action="Index" class="btn btn-link">Show all trips</a>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm hover-effect border-0">
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Destination" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">@item.Destination, @item.Country</h5>
                                <span class="badge bg-info text-dark">@item.Category</span>
                            </div>

                            <p class="card-text text-muted text-truncate">@item.Description</p>

                            <div class="mt-auto">
                                <hr />
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (item.SalePrice != null)
                                        {
                                            <small class="text-muted text-decoration-line-through d-block">$@item.Price</small>
                                            <span class="text-danger fw-bold fs-5">$@item.SalePrice</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold fs-5">$@item.Price</span>
                                        }
                                    </div>

                                    <a asp-action="Details" asp-route-id="@item.TripId" class="btn btn-outline-primary btn-sm px-3 rounded-pill">View Details</a>
                                </div>

                                @if (Context.Session.GetString("IsAdmin") == "true")
                                {
                                    <div class="mt-3 pt-2 border-top text-end">
                                        <a asp-action="Edit" asp-route-id="@item.TripId" class="btn btn-link btn-sm text-warning p-0 mx-1">Edit</a>
                                        <span class="text-muted">|</span>
                                        <a asp-action="Delete" asp-route-id="@item.TripId" class="btn btn-link btn-sm text-danger p-0 mx-1">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .hover-effect {
        transition: all 0.3s ease;
    }

        .hover-effect:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
        }

    .card-title {
        color: #2c3e50;
    }
</style>