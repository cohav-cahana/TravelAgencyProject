@model IEnumerable<TravelAgencyProject.Models.Trip>

@{
    ViewData["Title"] = "Trip Gallery";
}

<style>
    :root {
        --primary-blue: #0066ff;
        --soft-bg: #f8f9fa;
    }

    body {
        background-color: var(--soft-bg);
    }

    /* עיצוב הודעות מערכת צפות בראש העמוד */
    .alert-floating-container {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        width: 90%;
        max-width: 500px;
    }

    .alert-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        padding: 15px 20px;
        display: flex;
        align-items: center;
        backdrop-filter: blur(10px);
    }

    /* עיצוב הכרטיסים */
    .trip-card {
        border: none;
        border-radius: 20px;
        transition: all 0.4s ease;
        background: #fff;
        position: relative;
    }

        .trip-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
        }

    .img-container {
        position: relative;
        border-radius: 20px 20px 0 0;
        overflow: visible;
        height: 220px;
    }

    .trip-img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        border-radius: 20px 20px 0 0;
    }

    .category-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        background: rgba(0, 102, 255, 0.8) !important;
        backdrop-filter: blur(5px);
        border-radius: 50px;
        padding: 6px 14px;
        font-size: 0.75rem;
        z-index: 2;
    }

    .add-cart-wrapper {
        position: absolute;
        bottom: -25px;
        right: 20px;
        z-index: 10;
    }

    .btn-add-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: var(--primary-blue);
        color: white;
        border: 4px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: all 0.3s ease;
    }

        .btn-add-circle:hover {
            transform: scale(1.1) rotate(90deg);
            background-color: #0052cc;
            color: white;
        }

    .search-section {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        margin-bottom: 50px;
    }

    .price-regular {
        font-size: 1.5rem;
        font-weight: 800;
        color: #212529;
    }

    .price-sale {
        color: #dc3545;
        font-weight: 800;
        font-size: 1.5rem;
    }

    .price-old {
        font-size: 0.9rem;
        color: #adb5bd;
        text-decoration: line-through;
        display: block;
    }
</style>

<div class="alert-floating-container">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-custom alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>@TempData["Message"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-custom alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-5">
        <div>
            <h1 class="fw-bold display-5 mb-0">Explore <span class="text-primary">Trips</span></h1>
            <p class="text-muted">Find your next adventure</p>
        </div>
        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Add Trip</a>
        }
    </div>

    <div class="search-section">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="small fw-bold text-muted text-uppercase">Search</label>
                <input type="text" name="searchString" class="form-control bg-light border-0" placeholder="Where to?" value="@ViewData["CurrentFilter"]" />
            </div>
            <div class="col-md-3">
                <label class="small fw-bold text-muted text-uppercase">Category</label>
                <select name="category" class="form-select bg-light border-0">
                    <option value="">All</option>
                    <option value="Family">Family</option>
                    <option value="Adventure">Adventure</option>
                    <option value="Luxury">Luxury</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="small fw-bold text-muted text-uppercase">Sort</label>
                <select name="sortBy" class="form-select bg-light border-0">
                    <option value="date">Upcoming</option>
                    <option value="price_asc">Price: Low to High</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">Apply</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card trip-card shadow-sm h-100">
                    <div class="img-container">
                        <img src="@item.ImageUrl" class="trip-img" alt="@item.Destination">
                        <span class="badge category-badge">@item.Category</span>

                        <div class="add-cart-wrapper">
                            <form asp-action="AddToCart" asp-route-id="@item.TripId" method="post">
                                <button type="submit" class="btn btn-add-circle">
                                    <i class="bi bi-cart-plus fs-5"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card-body p-4 pt-5">
                        <span class="text-primary fw-bold small text-uppercase">@item.Country</span>
                        <h4 class="fw-bold mb-3">@item.Destination</h4>
                        <p class="text-muted small mb-4">@item.Description</p>

                        <div class="d-flex justify-content-between align-items-center mt-auto border-top pt-3">
                            <div>
                                @if (item.SalePrice != null && item.DiscountEndDate >= DateTime.Now)
                                {
                                    <small class="price-old">$@item.Price</small>
                                    <span class="price-sale">$@item.SalePrice</span>
                                }
                                else
                                {
                                    <span class="price-regular">$@item.Price</span>
                                }
                            </div>
                            <a asp-action="Details" asp-route-id="@item.TripId" class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-bold">Details</a>
                        </div>

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <div class="mt-3 pt-2 d-flex justify-content-center gap-3 border-top">
                                <a asp-action="Edit" asp-route-id="@item.TripId" class="text-warning small fw-bold text-decoration-none">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.TripId" class="text-danger small fw-bold text-decoration-none">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>