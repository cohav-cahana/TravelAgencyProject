@model IEnumerable<TravelAgencyProject.Models.Trip>

@{
    ViewData["Title"] = "Trip Gallery";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 text-primary fw-bold">Explore Our Trips</h1>
        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">+ Add New Trip</a>
        }
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-12">
            <form asp-action="Index" method="get" class="row g-2 shadow-sm p-4 bg-white rounded border border-primary">
                <div class="col-md-4">
                    <label class="small fw-bold text-muted">Search</label>
                    <input type="text" name="searchString" class="form-control"
                           placeholder="Where to?" value="@ViewData["CurrentFilter"]" />
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-muted">Category</label>
                    <select name="category" class="form-select">
                        <option value="">All Categories</option>
                        <option value="Family">Family</option>
                        <option value="Honeymoon">Honeymoon</option>
                        <option value="Adventure">Adventure</option>
                        <option value="Cruise">Cruise</option>
                        <option value="Luxury">Luxury</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="small fw-bold text-muted">Sort By</label>
                    <select name="sortBy" class="form-select">
                        <option value="date">Upcoming Dates</option>
                        <option value="price_asc">Price: Low to High</option>
                        <option value="price_desc">Price: High to Low</option>
                        <option value="destination">A-Z Destination</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100 fw-bold">Apply</button>
                </div>
            </form>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12 text-center mt-5">
                <h3 class="text-muted">No trips found matching your criteria.</h3>
                <a asp-action="Index" class="btn btn-link">Clear all filters</a>
            </div>
        }
        else
        {
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm hover-effect border-0 overflow-hidden">

                        <div class="position-relative">
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Destination" style="height: 220px; object-fit: cover;">
                            <span class="badge bg-primary position-absolute top-0 end-0 m-3 shadow">@item.Category</span>

                            <form asp-action="AddToCart" asp-route-id="@item.TripId" method="post">
                                <button type="submit" class="btn btn-primary rounded-circle position-absolute bottom-0 end-0 m-2 shadow-lg add-btn">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </form>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold mb-1">@item.Destination</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill"></i> @item.Country</p>
                            <p class="card-text text-muted text-truncate" style="max-height: 3em;">@item.Description</p>

                            <div class="mt-auto pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (item.SalePrice != null && item.DiscountEndDate >= DateTime.Now)
                                        {
                                            <small class="text-muted text-decoration-line-through d-block">$@item.Price</small>
                                            <span class="text-danger fw-bold fs-4">$@item.SalePrice</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold fs-4">$@item.Price</span>
                                        }
                                    </div>
                                    <a asp-action="Details" asp-route-id="@item.TripId" class="btn btn-outline-primary rounded-pill px-4">Details</a>
                                </div>

                                @if (Context.Session.GetString("IsAdmin") == "true")
                                {
                                    <div class="mt-3 pt-2 border-top text-center bg-light rounded">
                                        <a asp-action="Edit" asp-route-id="@item.TripId" class="btn btn-link btn-sm text-warning text-decoration-none">Edit</a>
                                        <span class="text-muted">|</span>
                                        <a asp-action="Delete" asp-route-id="@item.TripId" class="btn btn-link btn-sm text-danger text-decoration-none">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .hover-effect {
        transition: all 0.3s ease;
        border-radius: 15px;
    }

        .hover-effect:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
        }

    .card-img-top {
        transition: transform 0.5s ease;
    }

    .hover-effect:hover .card-img-top {
        transform: scale(1.05);
    }

    .form-control, .form-select {
        border-radius: 8px;
        padding: 10px;
    }

    .btn-primary {
        border-radius: 8px;
        padding: 10px 20px;
    }

    .add-btn {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease, background-color 0.2s;
        z-index: 10;
        border: 2px solid white;
    }

        .add-btn:hover {
            transform: scale(1.15);
            background-color: #0056b3;
        }
</style>