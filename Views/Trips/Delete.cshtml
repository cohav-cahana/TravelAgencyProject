@model TravelAgencyProject.Models.Trip

@{
    ViewData["Title"] = "Delete Trip";
}

<div class="container mt-5">
    <div class="card shadow-lg border-danger">
        <div class="card-header bg-danger text-white">
            <h3>Are you sure you want to delete this trip?</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center">
                    <img src="@Model.ImageUrl" class="img-fluid rounded mb-3" style="max-height: 200px;" />
                </div>
                <div class="col-md-8">
                    <h4>@Model.Destination, @Model.Country</h4>
                    <p class="text-muted">@Model.Description</p>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-4">Start Date</dt>
                        <dd class="col-sm-8">@Model.StartDate.ToShortDateString()</dd>

                        <dt class="col-sm-4">Price</dt>
                        <dd class="col-sm-8 font-weight-bold">$@Model.Price</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">@Model.Category</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
            <form asp-action="Delete">
                <input type="hidden" asp-for="TripId" />

                <button type="submit" class="btn btn-danger btn-lg">Yes, Delete Trip</button>
                <a asp-action="Index" class="btn btn-secondary btn-lg">Cancel</a>
            </form>
        </div>
    </div>
</div>