@model TravelAgencyProject.Models.Trip

@{
    ViewData["Title"] = "Create Trip";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0 h4"><i class="fas fa-plus-circle me-2"></i>Create New Travel Package</h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Destination" class="form-label fw-bold">Destination</label>
                        <input asp-for="Destination" class="form-control" placeholder="e.g. Paris" />
                        <span asp-validation-for="Destination" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Country" class="form-label fw-bold">Country</label>
                        <input asp-for="Country" class="form-control" placeholder="e.g. France" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Tell us about the trip..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Base Price ($)</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="SalePrice" class="form-label">Sale Price (Optional)</label>
                        <input asp-for="SalePrice" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="SalePrice" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DiscountEndDate" class="form-label">Discount End Date</label>
                        <input asp-for="DiscountEndDate" class="form-control" type="date" />
                        <span asp-validation-for="DiscountEndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row border-top pt-3 mt-2">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stock" class="form-label fw-bold">Available Rooms (Stock)</label>
                        <input asp-for="Stock" class="form-control" type="number" min="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="CancellationDeadlineHours" class="form-label fw-bold">Cancellation Deadline</label>
                        <div class="input-group">
                            <input asp-for="CancellationDeadlineHours" class="form-control" type="number" min="0" placeholder="e.g. 24" />
                            <span class="input-group-text bg-light border-start-0">hrs</span>
                        </div>
                        <small class="text-muted">Minimum hours required before departure to cancel.</small>
                        <span asp-validation-for="CancellationDeadlineHours" class="text-danger small d-block"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label fw-bold">Departure Date</label>
                        <input asp-for="StartDate" class="form-control" type="date" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label fw-bold">Return Date</label>
                        <input asp-for="EndDate" class="form-control" type="date" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-bold">Category</label>
                        <select asp-for="Category" class="form-select">
                            <option value="">-- Select Category --</option>
                            <option value="Family">Family</option>
                            <option value="Honeymoon">Honeymoon</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Cruise">Cruise</option>
                            <option value="Luxury">Luxury</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AgeLimitaion" class="form-label fw-bold">Age Restriction (Min Age)</label>
                        <input asp-for="AgeLimitaion" class="form-control" type="number" min="0" placeholder="e.g. 18" />
                        <span asp-validation-for="AgeLimitaion" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4 pt-2">
                    <label asp-for="ImageFile" class="form-label fw-bold">Cover Image <span class="text-danger">*</span></label>

                    <input type="hidden" asp-for="ImageUrl" />

                    @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                    {
                        <div class="d-flex align-items-center mb-3 p-2 border rounded bg-light">
                            <img src="@Model.ImageUrl" style="width: 80px; height: 60px; object-fit: cover; border-radius: 4px;" class="me-3 shadow-sm" />
                            <div>
                                <span class="badge bg-success mb-1">Current Image</span><br />
                                <small class="text-muted">Upload a new file only if you want to replace this one.</small>
                            </div>
                        </div>
                    }

                    <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" required />
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center border-top pt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">
                        Create Package
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}