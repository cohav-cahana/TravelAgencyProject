@model TravelAgencyProject.Models.Trip

@{
    ViewData["Title"] = "Trip Details";

    bool hasWaitingList = ViewBag.HasWaitingList ?? false;
    bool isInWaitingList = ViewBag.IsInWaitingList ?? false;
    bool canLeaveReview = ViewBag.CanLeaveReview ?? false;
    bool canBookNow = ViewBag.CanBookNow ?? false;

    var itinerary = new List<string>();
    switch (Model.Destination)
    {
        case "Paris":
            itinerary.AddRange(new[] { "Day 1: Arrival & Eiffel Tower at night", "Day 2: Louvre Museum and Seine River Cruise", "Day 3: Full day at Disneyland Paris", "Day 4: Montmartre district and departure" });
            break;
        case "London":
            itinerary.AddRange(new[] { "Day 1: Big Ben, London Eye and Southbank walk", "Day 2: British Museum and Covent Garden", "Day 3: Shopping at Oxford Street and Regent Street", "Day 4: Buckingham Palace and Flight home" });
            break;
        case "Tokyo":
            itinerary.AddRange(new[] { "Day 1: Shinjuku skyscrapers and nightlife", "Day 2: Tsukiji Fish Market and Ginza shopping", "Day 3: Harajuku fashion and Meiji Shrine", "Day 4: Akihabara tech town and departure" });
            break;
        case "New York":
            itinerary.AddRange(new[] { "Day 1: Times Square and Top of the Rock view", "Day 2: Statue of Liberty and Financial District", "Day 3: Central Park bike ride and Museum mile", "Day 4: Brooklyn Bridge and High Line walk" });
            break;
        case "Tel Aviv":
            itinerary.AddRange(new[] { "Day 1: Beach day and Gordon Pier", "Day 2: Carmel Market and Neve Tzedek walk", "Day 3: Old Jaffa port and Flea Market", "Day 4: Bauhaus architecture tour and departure" });
            break;
        case "Rome":
            itinerary.AddRange(new[] { "Day 1: Colosseum and Roman Forum", "Day 2: Vatican City and St. Peter's Basilica", "Day 3: Trevi Fountain and Spanish Steps", "Day 4: Trastevere food tour and departure" });
            break;
        case "Dubai":
            itinerary.AddRange(new[] { "Day 1: Burj Khalifa and Dubai Mall fountains", "Day 2: Desert Safari and traditional dinner", "Day 3: Palm Jumeirah and waterpark", "Day 4: Gold Souk and airport transfer" });
            break;
        default:
            itinerary.AddRange(new[] { "Day 1: Arrival, hotel check-in and welcome dinner", "Day 2: Guided city tour covering major landmarks", "Day 3: Free day for local exploration and shopping", "Day 4: Last minute souvenirs and transfer to airport" });
            break;
    }
}

<style>
    .btn-download-pdf {
        background: linear-gradient(135deg, #dc3545 0%, #a71d2a 100%);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-download-pdf:hover {
            background: linear-gradient(135deg, #a71d2a 0%, #86161f 100%);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.4) !important;
        }

    .review-lock-icon {
        font-size: 3rem;
        color: #dee2e6;
    }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-pill" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="row g-0">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid h-100" style="object-fit: cover; min-height: 400px; width: 100%;" alt="@Model.Destination" />
                }
            </div>

            <div class="col-md-6">
                <div class="card-body p-4 p-lg-5">
                    <h2 class="card-title fw-bold text-primary">@Model.Destination, @Model.Country</h2>
                    <span class="badge bg-info text-dark mb-3 px-3 py-2">@Model.Category</span>
                    <p class="card-text text-muted fs-5">@Model.Description</p>

                    <hr class="my-4" />

                    <div class="row">
                        <div class="col-6">
                            <h6 class="text-uppercase text-muted fw-bold small">📅 Dates</h6>
                            <p class="fs-5 mb-0">@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</p>
                        </div>
                        <div class="col-6 text-end">
                            <h6 class="text-uppercase text-muted fw-bold small">💰 Price</h6>
                            <p class="h3 text-success fw-bold mb-0">$@(Model.SalePrice ?? Model.Price)</p>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-6">
                            <h6 class="text-uppercase text-muted fw-bold small">🏨 Availability</h6>
                            @if (hasWaitingList && Model.Stock > 0)
                            {
                                <p class="fs-5 text-warning fw-bold mb-0">Reserved for Queue</p>
                                <small class="text-muted">(@Model.Stock room available for next in line)</small>
                            }
                            else if (Model.Stock <= 0)
                            {
                                <p class="fs-5 text-danger fw-bold mb-0">Sold Out</p>
                            }
                            else
                            {
                                <p class="fs-5 mb-0 @(Model.Stock <= 2 ? "text-danger fw-bold" : "")">
                                    @Model.Stock @(Model.Stock == 1 ? "Room" : "Rooms") Left
                                </p>
                            }
                        </div>
                        <div class="col-6 text-end">
                            <h6 class="text-uppercase text-muted fw-bold small">🔞 Restriction</h6>
                            <p class="fs-5 fw-bold mb-0 text-dark">
                                @if (Model.AgeLimitaion.HasValue && Model.AgeLimitaion.Value > 0)
                                {
                                    @:Age Limit @Model.AgeLimitaion
                                }
                                else
                                {
                                    @:No Age Limit
                                }
                            </p>
                        </div>
                    </div>

                    <div class="mt-5 d-flex flex-column gap-3">
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Back</a>

                            @if (Context.Session.GetString("IsAdmin") == "true")
                            {
                                <a asp-action="Edit" asp-route-id="@Model.TripId" class="btn btn-warning btn-lg rounded-pill px-4 shadow-sm">Edit Trip</a>
                            }
                            else
                            {
                                @if (canBookNow)
                                {
                                    <form asp-action="DirectPurchase" asp-controller="Booking" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tripId" value="@Model.TripId" />
                                        <button type="submit" class="btn btn-success btn-lg shadow rounded-pill px-4 fw-bold">
                                            ✈️ BOOK NOW
                                        </button>
                                    </form>
                                }
                                else if (isInWaitingList)
                                {
                                    <div class="d-flex flex-column w-100">
                                        <div class="alert alert-warning rounded-4 shadow-sm mb-2 p-3">
                                            <div class="fw-bold"><i class="bi bi-hourglass-split me-2"></i>You are on the waiting list</div>
                                            <div class="small">People ahead: <strong>@ViewBag.PeopleAhead</strong></div>
                                        </div>
                                        <button class="btn btn-secondary btn-lg shadow rounded-pill px-4 fw-bold" disabled>
                                            ✅ Position Reserved
                                        </button>
                                    </div>
                                }
                                else if (Model.Stock <= 0 || hasWaitingList)
                                {
                                    <form asp-action="JoinWaitingList" asp-controller="Trips" method="post" class="d-inline w-100">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="tripId" value="@Model.TripId" />
                                        <button type="submit" class="btn btn-warning btn-lg shadow rounded-pill px-4 fw-bold w-100">
                                            ⏳ Join Waiting List
                                        </button>
                                    </form>
                                }
                            }
                        </div>

                        <button id="download-itinerary" class="btn btn-download-pdf btn-lg rounded-pill px-4 shadow-sm fw-bold w-100">
                            <i class="bi bi-file-earmark-pdf-fill me-2 fs-4"></i> Download Trip Plan (PDF)
                        </button>
                    </div>

                    <div id="itinerary-content" style="display: none; background: white; padding: 50px;">
                        <h1 style="color: #0d6efd;">Travel Plan: @Model.Destination</h1>
                        <p><strong>Dates:</strong> @Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</p>
                        <hr />
                        <h3>Itinerary</h3>
                        @foreach (var day in itinerary)
                        {
                            <p style="padding: 10px; border-left: 5px solid #0d6efd; background: #f8f9fa;">@day</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Reviews Section *@
    <div class="mt-5 pt-4">
        <h3 class="fw-bold mb-4"><i class="bi bi-chat-left-text me-2 text-primary"></i>Customer Reviews</h3>

        @if (canLeaveReview)
        {
            <div class="card shadow-sm border-0 rounded-4 p-4 mb-5 bg-light">
                <h5 class="fw-bold mb-3">Add a Review</h5>
                <form asp-controller="Reviews" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="TripId" value="@Model.TripId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Rating</label>
                        <select name="Rating" class="form-select border-0 shadow-sm rounded-pill">
                            <option value="5">⭐⭐⭐⭐⭐ (Excellent)</option>
                            <option value="4">⭐⭐⭐⭐ (Good)</option>
                            <option value="3">⭐⭐⭐ (Average)</option>
                            <option value="2">⭐⭐ (Poor)</option>
                            <option value="1">⭐ (Terrible)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Your Comment</label>
                        <textarea name="Comment" class="form-control border-0 shadow-sm rounded-4" rows="3" placeholder="Share your experience..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Submit Review</button>
                </form>
            </div>
        }

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews.OrderByDescending(r => r.PostedDate))
            {
                <div class="card mb-3 shadow-sm border-0 rounded-4 p-2">
                    <div class="card-body">
                        <h6 class="fw-bold text-primary">@review.User?.FirstName @review.User?.LastName</h6>
                        <div class="text-warning mb-2">
                            @for (int i = 0; i < 5; i++)
                            {
                                <i class="bi bi-star@(i < review.Rating ? "-fill" : "")"></i>
                            }
                        </div>
                        <p class="card-text">@review.Comment</p>
                        <small class="text-muted">@review.PostedDate.ToShortDateString()</small>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center text-muted">No reviews yet.</p>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        document.getElementById('download-itinerary').addEventListener('click', function () {
            const itineraryData = @Html.Raw(Json.Serialize(itinerary));

            const docDefinition = {
                content: [
                    { text: 'TRAVEL PLAN: ' + '@Model.Destination'.toUpperCase(), style: 'header' },
                    { text: 'Country: ' + '@Model.Country', style: 'subheader' },
                    { text: 'Dates: ' + '@Model.StartDate.ToShortDateString()' + ' - ' + '@Model.EndDate.ToShortDateString()', margin: [0, 0, 0, 20] },
                    { text: '__________________________________________________________', margin: [0, 0, 0, 20] },
                    { text: 'DETAILED ITINERARY', style: 'subheader', margin: [0, 10, 0, 10] },
                    {
                        stack: itineraryData.map(day => ({
                            text: day,
                            margin: [0, 5, 0, 5],
                            padding: [10, 10],
                            background: '#f8f9fa'
                        }))
                    },
                    { text: '\n\nEnjoy your trip with Travel Agency!', alignment: 'center', italic: true, color: '#888888' }
                ],
                styles: {
                    header: { fontSize: 24, bold: true, color: '#0d6efd', margin: [0, 0, 0, 5] },
                    subheader: { fontSize: 16, bold: true, color: '#333333', margin: [0, 5, 0, 5] }
                },
                defaultStyle: {
                    font: 'Roboto'
                }
            };

            pdfMake.createPdf(docDefinition).download('Itinerary_@Model.Destination' + '.pdf');
        });
    </script>
}