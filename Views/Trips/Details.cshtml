@model TravelAgencyProject.Models.Trip

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="row g-0">
            <div class="col-md-6">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                <img src="@Model.ImageUrl" class="img-fluid rounded-start h-100" style="object-fit: cover; min-height: 400px; width: 100%;" alt="@Model.Destination" />
                }
            </div>

            <div class="col-md-6">
                <div class="card-body p-4">
                    <h2 class="card-title fw-bold text-primary">@Model.Destination, @Model.Country</h2>
                    <span class="badge bg-info text-dark mb-3">@Model.Category</span>

                    <p class="card-text text-muted">@Model.Description</p>

                    <hr />

                    <div class="row mt-4">
                        <div class="col-6">
                            <h5><strong>📅 Dates:</strong></h5>
                            <p>@Model.StartDate.ToShortDateString() - @Model.EndDate.ToShortDateString()</p>
                        </div>
                        <div class="col-6 text-end">
                            <h5><strong>💰 Price:</strong></h5>
                            <p class="h4 text-success font-weight-bold">$@Model.Price</p>
                        </div>
                    </div>

                    <div class="mt-5 d-flex gap-2 align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Back to List</a>

                        @if (Context.Session.GetString("IsAdmin") != "true")
                        {
                            @* Using a form to trigger AddToCart with immediate redirect to Checkout *@
                            <form asp-action="AddToCart" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.TripId" />
                                <input type="hidden" name="goToCheckout" value="true" />
                                <button type="submit" class="btn btn-success btn-lg shadow fw-bold">
                                    ✈️ BOOK NOW
                                </button>
                            </form>
                        }

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                        <a asp-action="Edit" asp-route-id="@Model.TripId" class="btn btn-warning btn-lg">Edit Trip</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>