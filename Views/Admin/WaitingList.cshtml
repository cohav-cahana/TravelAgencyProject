@model IEnumerable<TravelAgencyProject.Models.WaitingList>

@{
    ViewData["Title"] = "Waiting List Management";
}

<div class="container mt-4">
    <h2 class="mb-4">Admin - Waiting List Management</h2>

    <table class="table table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Customer Name</th>
                <th>Trip</th>
                <th>Request Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.User?.FirstName @item.User?.LastName</td>
                    <td>@item.Trip?.Destination</td>
                    <td>@item.RequestDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (item.HasBeenNotified)
                        {
                            <span class="badge bg-success">Notified</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary">Notify</button>
                        <button class="btn btn-sm btn-outline-danger">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>