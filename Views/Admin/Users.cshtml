@model IEnumerable<TravelAgencyProject.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    @* --- כותרת וכפתור הוספה --- *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">User Management</h2>
            <p class="text-muted small">Manage system users, permissions, and active accounts</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-person-plus-fill me-2"></i>Add New User
        </a>
    </div>

    @* --- כרטיסי סיכום (Stats Cards) --- *@
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-people text-primary fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Total Users</h6>
                        <h4 class="fw-bold mb-0">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-shield-lock text-danger fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Admins</h6>
                        <h4 class="fw-bold mb-0">@Model.Count(u => u.IsAdmin)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Active Accounts</h6>
                        <h4 class="fw-bold mb-0">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* --- טבלת משתמשים --- *@
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 border-0 text-muted text-uppercase small">Full Name</th>
                        <th class="border-0 text-muted text-uppercase small">Email / Username</th>
                        <th class="border-0 text-muted text-uppercase small">Role</th>
                        <th class="border-0 text-muted text-uppercase small">Status</th>
                        <th class="text-center border-0 text-muted text-uppercase small">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3">@user.FirstName[0]@user.LastName[0]</div>
                                    <span class="fw-bold text-dark">@user.FirstName @user.LastName</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted small">@user.Email</span>
                            </td>
                            <td>
                                @if (user.IsAdmin)
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">
                                        <i class="bi bi-shield-check me-1"></i> Admin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary px-3 py-2 rounded-pill border">
                                        <i class="bi bi-person me-1"></i> User
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-circle-fill me-1 small"></i> Active
                                </span>
                            </td>
                            <td class="text-center pe-4">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a asp-action="UserBookings" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-info rounded-pill px-3 shadow-sm hover-elevate">
                                        <i class="bi bi-calendar-check me-1"></i> Bookings
                                    </a>

                                    @if (!user.IsAdmin)
                                    {
                                        <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" class="m-0">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill shadow-sm hover-elevate">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* --- כפתור חזרה --- *@
    <div class="mt-4 pb-5">
        <a asp-action="Index" class="btn btn-link text-muted text-decoration-none p-0">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

@* --- CSS מותאם אישית --- *@
<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .avatar-circle {
        width: 38px;
        height: 38px;
        background: linear-gradient(135deg, #0d6efd, #0043a8);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.85rem;
        text-transform: uppercase;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .table thead th {
        padding-top: 15px;
        padding-bottom: 15px;
        font-weight: 600;
        letter-spacing: 0.5px;
        background-color: #fcfcfc;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.02);
        }

    .bg-danger-subtle {
        background-color: #ffe5e7;
    }

    .bg-success-subtle {
        background-color: #e7f5ea;
    }

    .text-danger {
        color: #dc3545;
    }

    .text-success {
        color: #198754;
    }

    .hover-elevate {
        transition: transform 0.2s ease;
    }

        .hover-elevate:hover {
            transform: translateY(-2px);
        }

    .badge {
        font-weight: 500;
    }
</style>