@model IEnumerable<TravelAgencyProject.Models.Trip>

@{
    ViewData["Title"] = "Cart Checkout";
    // Sum prices to show to the customer
    decimal totalPricePerPerson = Model.Sum(t => t.SalePrice ?? t.Price);

    // List of trips that sold out during checkout
    List<int> soldOutIds = new List<int>();
    if (TempData["SoldOutTripIds"] != null)
    {
        soldOutIds = System.Text.Json.JsonSerializer.Deserialize<List<int>>(
            TempData["SoldOutTripIds"].ToString()
        ) ?? new List<int>();
    }
}

<div class="container py-5">
    <div class="row g-5">

        <div class="col-md-5 col-lg-4 order-md-last">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-primary fw-bold">Order Summary</span>
                <span class="badge bg-primary rounded-pill">@Model.Count()</span>
            </h4>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <ul class="list-group list-group-flush">
                    @foreach (var trip in Model)
                    {
                        <li class="list-group-item p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="my-0 fw-bold">@trip.Destination</h6>
                                    <small class="text-muted">@trip.Country | @trip.Category</small>
                                </div>
                                <span class="text-muted">$@(trip.SalePrice ?? trip.Price)</span>
                            </div>
                        </li>
                    }

                    <li class="list-group-item p-3 bg-light">
                        <div class="d-flex justify-content-between small fw-bold">
                            <span>Travelers</span>
                            <span id="summary-people">1</span>
                        </div>
                    </li>

                    <li class="list-group-item p-3 border-top border-primary">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total</span>
                            <strong class="text-primary fs-4" id="summary-total">$@totalPricePerPerson.ToString("N0")</strong>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        <div class="col-md-7 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                <h2 class="mb-4 fw-bold">Complete Your Booking</h2>

                @* User Alerts *@
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mt-3">@TempData["SuccessMessage"]</div>
                }

                @* Sold-out logic notification *@
                @if (TempData["SoldOutMessage"] != null && soldOutIds.Any())
                {
                    <div class="alert alert-warning mt-3">
                        <div class="fw-bold">@TempData["SoldOutMessage"]</div>
                        <div class="mt-3">
                            @foreach (var trip in Model)
                            {
                                if (soldOutIds.Contains(trip.TripId))
                                {
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center border rounded-3 p-3 mb-2 bg-white">
                                        <div class="me-3">
                                            The last spot for <b>@trip.Destination</b> was taken by someone else.
                                        </div>
                                        <form asp-controller="Trips" asp-action="JoinWaitingList" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="tripId" value="@trip.TripId" />
                                            <button type="submit" class="btn btn-outline-primary btn-sm">Join Waiting List</button>
                                        </form>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                <form id="checkoutForm" asp-controller="Trips" asp-action="ProcessCartBooking" method="post">
                    @Html.AntiForgeryToken()

                    @* Plan B: Hidden field to ensure Trip IDs persist even if session fails *@
                    <input type="hidden" name="tripIdsString" value="@string.Join(",", Model.Select(t => t.TripId))" />

                    <div class="section-header mb-4">
                        <h5 class="fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i> Traveler Details</h5>
                    </div>

                    <div class="p-4 bg-light rounded-4 border mb-5">
                        <label class="form-label fw-bold text-dark mb-3">Number of Travelers</label>
                        <div class="input-group input-group-lg shadow-sm" style="max-width: 300px;">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-person-plus text-primary"></i></span>
                            <input type="number" name="peopleCount" id="peopleInput" class="form-control border-start-0 fw-bold" min="1" max="10" value="1" required />
                        </div>
                    </div>

                    <div class="section-header mb-4">
                        <h5 class="fw-bold"><i class="bi bi-credit-card-2-back-fill me-2 text-primary"></i> Secure Payment</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <input type="text" name="cardNumber" class="form-control form-control-lg" placeholder="Card Number (16 digits)" required pattern="\d{16}">
                        </div>
                        <div class="col-md-6">
                            <input type="text" name="expiryDate" class="form-control form-control-lg" placeholder="MM/YY" required pattern="(0[1-9]|1[0-2])\/[2-9][0-9]">
                        </div>
                        <div class="col-md-6">
                            <input type="password" name="cvv" class="form-control form-control-lg" placeholder="CVV" required pattern="\d{3}" maxlength="3">
                        </div>
                    </div>

                    <button id="confirmBtn" class="btn btn-primary btn-lg w-100 mt-4 py-3 fw-bold rounded-pill" type="submit">
                        CONFIRM & PAY NOW
                    </button>

                    <div id="paypal-button-container" class="mt-3"></div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://www.paypal.com/sdk/js?client-id=AaosWn1s4rmQtfOcldU0sLu1DD9PiPEO6AHZ84cpwrRmFNZeZgwhkwGdkMAAWCitNO2v6n4V3vKbG9zd&currency=USD"></script>

    <script>
        paypal.Buttons({
            createOrder: function(data, actions) {
                const count = document.getElementById('peopleInput').value || 1;
                const pricePerPerson = parseFloat('@totalPricePerPerson');
                const finalAmount = (count * pricePerPerson).toFixed(2);

                return actions.order.create({
                    purchase_units: [{
                        amount: { value: finalAmount }
                    }]
                });
            },
            onApprove: function(data, actions) {
                return actions.order.capture().then(function(details) {
                    const count = document.getElementById('peopleInput').value || 1;
                    const trips = "@string.Join(",", Model.Select(t => t.TripId))";

                    // Construct redirect URL with parameters
                    const url = "/Trips/PayPalSuccess?orderId=" + data.orderID +
                                "&peopleCount=" + count +
                                "&tripIds=" + trips;

                    window.location.href = url;
                });
            },
            onError: function(err) {
                alert('Payment error occurred. Please try again.');
            }
        }).render('#paypal-button-container');

        // Dynamic pricing UI update
        const peopleInput = document.getElementById('peopleInput');
        peopleInput.addEventListener('input', function () {
            const count = Math.max(1, this.value);
            document.getElementById('summary-people').innerText = count;
            const total = (count * @totalPricePerPerson).toLocaleString();
            document.getElementById('summary-total').innerText = '$' + total;
        });

        document.getElementById('checkoutForm').addEventListener('submit', function() {
            document.getElementById('confirmBtn').disabled = true;
            document.getElementById('confirmBtn').innerText = "Processing Transaction...";
        });
    </script>
}