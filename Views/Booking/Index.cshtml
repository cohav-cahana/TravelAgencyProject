@model IEnumerable<TravelAgencyProject.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-suit-case-lg"></i> My Bookings</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <p class="mb-0">You haven't booked any trips yet. <a asp-controller="Trips" asp-action="Index" class="alert-link">Explore our trips here!</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Trip Destination</th>
                        <th>Booking Date</th>
                        <th>Travelers</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Trip.Destination</strong><br />
                                <small class="text-muted">@item.Trip.Country</small>
                            </td>
                            <td>@item.BookingDate.ToShortDateString()</td>
                            <td>@item.PeopleCount</td>
                            <td class="fw-bold">$@item.TotalPrice</td>
                            <td>
                                <span class="badge @(item.bookingStatus == TravelAgencyProject.Models.TripStatus.Upcoming ? "bg-success" : "bg-secondary")">
                                    @item.bookingStatus
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-outline-danger btn-sm" disabled>Cancel</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>