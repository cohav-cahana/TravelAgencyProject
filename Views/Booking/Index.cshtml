@model IEnumerable<TravelAgencyProject.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    var pastBookings = ViewBag.PastBookings as List<TravelAgencyProject.Models.Booking>;
}

@* --- Optimized Styles --- *@
<style>
    .booking-card {
        transition: all 0.3s ease;
        border: none;
        background: #fff;
    }

        .booking-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .trip-image {
        height: 100%;
        min-height: 200px;
        object-fit: cover;
    }

    .countdown-timer {
        font-family: 'Segoe UI Mono', monospace;
        letter-spacing: 1px;
        font-size: 1rem;
        background: #f8f9fa;
        padding: 8px 15px;
        border-radius: 50px;
        border: 1px solid #dee2e6;
        display: inline-block;
    }

    .text-danger.animate-pulse {
        animation: pulse-red 2s infinite;
        background: #fff5f5;
        border-color: #feb2b2;
    }

    @@keyframes pulse-red {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.6;
        }

        100% {
            opacity: 1;
        }
    }

    .status-badge {
        position: absolute;
        top: 15px;
        left: 15px;
        z-index: 10;
    }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-bold"><i class="bi bi-luggage-fill text-primary"></i> My Bookings</h1>
            <p class="text-muted mb-0">Manage your upcoming adventures and travel history</p>
        </div>
        <a asp-controller="Trips" asp-action="Index" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg"></i> New Booking
        </a>
    </div>

    @* --- Alerts --- *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm rounded-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    @* --- Upcoming Bookings --- *@
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
            <i class="bi bi-airplane text-light" style="font-size: 4rem;"></i>
            <h3 class="mt-3">No upcoming trips</h3>
            <p class="text-muted">The world is huge, go explore it!</p>
            <a asp-controller="Trips" asp-action="Index" class="btn btn-outline-primary rounded-pill">Find a Trip</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card booking-card shadow-sm rounded-4 overflow-hidden">
                        <div class="row g-0">
                            <div class="col-md-3 position-relative">
                                <img src="@(item.Trip?.ImageUrl ?? "/images/default-trip.jpg")" class="trip-image w-100" alt="Destination">
                                <div class="status-badge">
                                    @if (item.bookingStatus == TravelAgencyProject.Models.TripStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger shadow">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success shadow">Upcoming</span>
                                    }
                                </div>
                            </div>

                            <div class="col-md-6 p-4">
                                <div class="mb-2">
                                    <small class="text-uppercase text-muted fw-bold letter-spacing-1">@item.Trip?.Country</small>
                                    <h3 class="fw-bold text-dark">@item.Trip?.Destination</h3>
                                </div>

                                <div class="d-flex gap-4 mb-3">
                                    <div>
                                        <small class="text-muted d-block small">DEPARTURE</small>
                                        <span class="fw-bold"><i class="bi bi-calendar3 me-1 text-primary"></i>@item.Trip?.StartDate.ToShortDateString()</span>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block small">TRAVELERS</small>
                                        <span class="fw-bold"><i class="bi bi-people me-1 text-primary"></i>@item.PeopleCount</span>
                                    </div>
                                </div>

                                @if (item.bookingStatus == TravelAgencyProject.Models.TripStatus.Upcoming)
                                {
                                    <div class="mt-3">
                                        <div class="countdown-timer fw-bold text-primary"
                                             id="timer-@item.BookingId"
                                             data-startdate="@item.Trip?.StartDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                                            Loading...
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="col-md-3 bg-light p-4 d-flex flex-column justify-content-center border-start">
                                <div class="text-center mb-4">
                                    <small class="text-muted d-block">Total Paid</small>
                                    <h2 class="fw-bold text-primary mb-0">$@item.TotalPrice</h2>
                                </div>

                                <div class="d-grid gap-2">
                                    @if (item.bookingStatus != TravelAgencyProject.Models.TripStatus.Cancelled)
                                    {
                                        <button onclick="downloadBookingPDF('@item.BookingId', '@item.Trip?.Destination', '@item.Trip?.Country', '@item.BookingDate.ToShortDateString()', '@item.PeopleCount', '@item.TotalPrice')"
                                                class="btn btn-success rounded-pill btn-sm">
                                            <i class="bi bi-file-earmark-pdf"></i> Download Receipt
                                        </button>

                                        <form asp-controller="Trips" asp-action="CancelBooking" asp-route-id="@item.BookingId" method="post"
                                              onsubmit="return confirm('Cancel this trip? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger rounded-pill btn-sm w-100">
                                                <i class="bi bi-x-circle"></i> Cancel Booking
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-light rounded-pill disabled btn-sm">Refund Processed</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* --- History Section --- *@
    @if (pastBookings != null && pastBookings.Any())
    {
        <div class="mt-5 pt-4 border-top">
            <h4 class="fw-bold text-muted mb-4"><i class="bi bi-clock-history"></i> Where You've Been</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var past in pastBookings)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm rounded-3 opacity-75">
                            <div class="card-body">
                                <h6 class="fw-bold mb-1">@past.Trip?.Destination</h6>
                                <p class="small text-muted mb-2">@past.Trip?.StartDate.ToShortDateString()</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-secondary">Completed</span>
                                    <span class="fw-bold text-dark">$@past.TotalPrice</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script>
        // All your existing JavaScript (downloadBookingPDF & updateCountdowns)
        // remains exactly the same and will work with the new IDs
        function downloadBookingPDF(id, dest, country, date, people, price) {
            const element = document.createElement('div');
            element.innerHTML = `
                <div style="padding: 40px; font-family: sans-serif; color: #333;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #0d6efd;">TravelAgency</h1>
                        <p style="color: #6c757d;">Official Booking Receipt</p>
                    </div>
                    <hr style="border-top: 2px solid #eee; margin-bottom: 30px;">
                    <h3>Order Details - #${id}</h3>
                    <p><strong>Destination:</strong> ${dest}, ${country}</p>
                    <p><strong>Travelers:</strong> ${people}</p>
                    <div style="background: #f8f9fa; padding: 20px; margin-top: 20px; border-radius: 8px;">
                        <h2 style="color: #0d6efd; margin: 0;">Total Paid: $${price}</h2>
                    </div>
                </div>
            `;
            html2pdf().set({ margin: 10, filename: 'Receipt_'+id+'.pdf', html2canvas: { scale: 2 } }).from(element).save();
        }

        function updateCountdowns() {
            const now = new Date().getTime();
            document.querySelectorAll('.countdown-timer').forEach(timer => {
                const startDateStr = timer.getAttribute('data-startdate');
                const startDate = new Date(startDateStr).getTime();
                const distance = startDate - now;
                if (distance < 0) {
                    timer.innerHTML = "Trip in progress!";
                    timer.className = "countdown-timer fw-bold text-success";
                    return;
                }
                if (distance < 86400000) {
                    timer.classList.add('text-danger', 'animate-pulse');
                }
                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);
                timer.innerHTML = `${days}d ${hours}h ${minutes}m ${seconds}s`;
            });
        }
        updateCountdowns();
        setInterval(updateCountdowns, 1000);
    </script>
}