@model IEnumerable<TravelAgencyProject.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
    var pastBookings = ViewBag.PastBookings as List<TravelAgencyProject.Models.Booking>;
}

<div class="container mt-5">
    <h2 class="mb-4"><i class="bi bi-suit-case-lg"></i> My Bookings</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            <p class="mb-0">You haven't booked any upcoming trips yet. <a asp-controller="Trips" asp-action="Index" class="alert-link">Explore our trips here!</a></p>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Trip Destination</th>
                        <th>Booking Date</th>
                        <th>Travelers</th>
                        <th>Total Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Trip?.Destination</strong><br />
                                <small class="text-muted">@item.Trip?.Country</small>
                            </td>
                            <td>@item.BookingDate.ToShortDateString()</td>
                            <td>@item.PeopleCount</td>
                            <td class="fw-bold">$@item.TotalPrice</td>
                            <td>
                                <span class="badge bg-success">Upcoming</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    @if (item.bookingStatus != TravelAgencyProject.Models.TripStatus.Cancelled)
                                    {
                                        @* --- PDF Download Button --- *@
                                        <button onclick="downloadBookingPDF('@item.BookingId', '@item.Trip?.Destination', '@item.Trip?.Country', '@item.BookingDate.ToShortDateString()', '@item.PeopleCount', '@item.TotalPrice')"
                                                class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-file-earmark-pdf"></i> Receipt
                                        </button>

                                        @* --- Cancel Button --- *@
                                        <form asp-controller="Trips" asp-action="CancelBooking" asp-route-id="@item.BookingId" method="post"
                                              onsubmit="return confirm('Are you sure you want to cancel this booking? The seats will be returned to stock.');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light" disabled>Cancelled</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (pastBookings != null && pastBookings.Any())
    {
        <div class="mt-5">
            <button class="btn btn-outline-secondary shadow-sm mb-4" type="button"
                    data-bs-toggle="collapse" data-bs-target="#historySection">
                <i class="bi bi-clock-history me-2"></i> SHOW HISTORY
            </button>

            <div class="collapse" id="historySection">
                <h4 class="text-muted mb-3">Past Destinations</h4>
                <div class="table-responsive shadow-sm rounded">
                    <table class="table table-sm table-striped align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Destination</th>
                                <th>Date</th>
                                <th>Travelers</th>
                                <th>Total Paid</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var past in pastBookings)
                            {
                                <tr class="opacity-75">
                                    <td><strong>@past.Trip?.Destination</strong></td>
                                    <td>@past.Trip?.StartDate.ToShortDateString()</td>
                                    <td>@past.PeopleCount</td>
                                    <td>$@past.TotalPrice</td>
                                    <td><span class="badge bg-secondary">Completed</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
@* Load html2pdf library *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        function downloadBookingPDF(id, dest, country, date, people, price) {
            // Create a styled HTML element for the PDF content
            const element = document.createElement('div');
            element.innerHTML = `
                <div style="padding: 40px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333;">
                    <div style="text-align: center; margin-bottom: 30px;">
                        <h1 style="color: #0d6efd; margin-bottom: 5px;">TravelAgency Service</h1>
                        <p style="color: #6c757d;">Official Booking Receipt</p>
                    </div>
                    <hr style="border: 0; border-top: 2px solid #eee; margin-bottom: 30px;">

                    <h3 style="color: #198754; margin-bottom: 20px;">Booking Details - Order #${id}</h3>
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px;">
                        <tr>
                            <td style="padding: 12px 0; font-weight: bold; border-bottom: 1px solid #eee;">Destination:</td>
                            <td style="padding: 12px 0; border-bottom: 1px solid #eee;">${dest}, ${country}</td>
                        </tr>
                        <tr>
                            <td style="padding: 12px 0; font-weight: bold; border-bottom: 1px solid #eee;">Booking Date:</td>
                            <td style="padding: 12px 0; border-bottom: 1px solid #eee;">${date}</td>
                        </tr>
                        <tr>
                            <td style="padding: 12px 0; font-weight: bold; border-bottom: 1px solid #eee;">Number of Travelers:</td>
                            <td style="padding: 12px 0; border-bottom: 1px solid #eee;">${people}</td>
                        </tr>
                        <tr style="background-color: #f8f9fa;">
                            <td style="padding: 15px 10px; font-weight: bold; color: #0d6efd; font-size: 1.2em;">Total Paid:</td>
                            <td style="padding: 15px 10px; color: #0d6efd; font-size: 1.2em; font-weight: bold; text-align: right;">$${price}</td>
                        </tr>
                    </table>

                    <div style="margin-top: 50px; font-size: 0.9em; color: #777; text-align: center; border-top: 1px solid #eee; pt-20">
                        <p>Thank you for choosing TravelAgency for your journey!</p>
                        <p>If you have any questions, please contact our support.</p>
                    </div>
                </div>
            `;

            const opt = {
                margin: 10,
                filename: 'TravelAgency_Receipt_' + id + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            // Process and Save the PDF
            html2pdf().set(opt).from(element).save();
        }
    </script>
}