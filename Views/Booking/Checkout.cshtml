@model TravelAgencyProject.Models.Booking

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4 order-md-2 mb-4">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">Order Summary</span>
            </h4>
            <ul class="list-group mb-3 shadow-sm">
                <li class="list-group-item d-flex justify-content-between lh-condensed">
                    <div>
                        <h6 class="my-0">@Model.Trip.Destination</h6>
                        <small class="text-muted">@Model.Trip.Country</small>
                    </div>
                    <span class="text-muted">$@Model.Trip.Price</span>
                </li>
                <li class="list-group-item d-flex justify-content-between bg-light">
                    <span class="text-success fw-bold">Total (USD)</span>
                    <strong class="text-success">$@Model.TotalPrice</strong>
                </li>
            </ul>
        </div>

        <div class="col-md-8 order-md-1">
            <div class="card shadow-sm p-4">
                <h4 class="mb-3">Booking Details</h4>
                <form asp-action="ProcessBooking" method="post">
                    <input type="hidden" asp-for="TripId" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label asp-for="PeopleCount">How many people?</label>
                        <input type="number" asp-for="PeopleCount" class="form-control" min="1" max="10" required />
                    </div>

                    <hr class="my-4">

                    <h4 class="mb-3 text-primary"><i class="bi bi-credit-card"></i> Secure Payment</h4>
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label>Card Number</label>
                            <input type="text" class="form-control" placeholder="1234 5678 9101 1121" required pattern="\d{16}" title="Please enter 16 digits" />
                            <small class="text-muted text-danger">Notice: Credit card numbers are not stored in our database.</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Expiration Date</label>
                            <input type="text" class="form-control" placeholder="MM/YY" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>CVV</label>
                            <input type="text" class="form-control" placeholder="123" required />
                        </div>
                    </div>

                    <button class="btn btn-success btn-lg w-100 mt-4 shadow" type="submit">
                        CONFIRM & PAY NOW
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>