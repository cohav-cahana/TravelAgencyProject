@model TravelAgencyProject.Models.Booking

<div class="container py-5">
    <div class="row g-5">
        <div class="col-md-5 col-lg-4 order-md-last">
            <h4 class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-primary fw-bold">Order Summary</span>
            </h4>
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                @if (Model.Trip != null)
                {
                    <img src="@Model.Trip.ImageUrl" class="card-img-top" style="height: 160px; object-fit: cover;" alt="Trip Image">
                }
                <ul class="list-group list-group-flush">
                    <li class="list-group-item p-3">
                        <h6 class="my-0 fw-bold">@Model.Trip.Destination</h6>
                        <small class="text-muted">@Model.Trip.Country | @Model.Trip.Category</small>
                    </li>
                    <li class="list-group-item p-3 bg-light">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Price per traveler</span>
                            <span>$@Model.Trip.Price</span>
                        </div>
                        <div class="d-flex justify-content-between small fw-bold">
                            <span>Travelers</span>
                            <span id="summary-people">1</span>
                        </div>
                    </li>
                    <li class="list-group-item p-3 border-top border-primary">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold fs-5">Total</span>
                            <strong class="text-primary fs-4" id="summary-total">$@Model.Trip.Price</strong>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="mt-3 p-3 bg-white rounded-3 shadow-sm border text-center">
                <small class="text-muted"><i class="bi bi-shield-lock-fill text-success"></i> Secure Checkout</small>
            </div>
        </div>

        <div class="col-md-7 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5">
                <h2 class="mb-4 fw-bold">Complete Your Booking</h2>

                <form asp-action="ProcessBooking" method="post">
                    <input type="hidden" asp-for="TripId" />
                    <input type="hidden" asp-for="UserId" />

                    <div class="section-header mb-4">
                        <h5 class="fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i> Travelers</h5>
                    </div>

                    <div class="p-4 bg-light rounded-4 border mb-5">
                        <label asp-for="PeopleCount" class="form-label fw-bold text-dark mb-3">How many people are joining?</label>
                        <div class="input-group input-group-lg shadow-sm" style="max-width: 300px;">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-person-plus text-primary"></i>
                            </span>
                            <input type="number" asp-for="PeopleCount" id="peopleInput"
                                   class="form-control border-start-0 fw-bold"
                                   min="1" max="10" value="1" required />
                        </div>
                        <div class="form-text mt-3 text-muted">
                            <i class="bi bi-info-circle me-1"></i> The price will update automatically based on your selection.
                        </div>
                    </div>

                    <div class="section-header mb-4">
                        <h5 class="fw-bold"><i class="bi bi-credit-card-2-back-fill me-2 text-primary"></i> Payment Method</h5>
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted text-uppercase">Card Number</label>
                            <div class="input-group input-group-lg shadow-sm">
                                <input type="text" class="form-control border-end-0" placeholder="0000 0000 0000 0000" required pattern="\d{16}">
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-credit-card"></i></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">Expiry Date</label>
                            <input type="text" class="form-control form-control-lg shadow-sm" placeholder="MM / YY" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted text-uppercase">CVV</label>
                            <input type="password" class="form-control form-control-lg shadow-sm" placeholder="•••" required maxlength="3">
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 mt-4 rounded-3 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <small>Your security is important. We do not store your full credit card information in our database.</small>
                    </div>

                    <button class="btn btn-primary btn-lg w-100 mt-4 py-3 fw-bold shadow-lg rounded-pill" type="submit">
                        CONFIRM & PAY NOW
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .rounded-4 {
        border-radius: 1.25rem;
    }

    .card {
        border: none;
    }

    /* עיצוב שדה המספר */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        opacity: 1; /* להשאיר את החצים גלויים וברורים */
    }

    .form-control:focus, .input-group-text:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .btn-primary {
        background: linear-gradient(45deg, #0d6efd, #0052cc);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(13, 110, 253, 0.4);
        }
</style>

@section Scripts {
    <script>
        const peopleInput = document.getElementById('peopleInput');
        const summaryPeople = document.getElementById('summary-people');
        const summaryTotal = document.getElementById('summary-total');
        const pricePerPerson = @Model.Trip.Price;

        peopleInput.addEventListener('input', function() {
            const count = Math.max(1, this.value);
            summaryPeople.innerText = count;
            summaryTotal.innerText = '$' + (count * pricePerPerson).toLocaleString();
        });
    </script>
}