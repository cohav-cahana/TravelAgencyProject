@model TravelAgencyProject.Models.Trip

<div class="container mt-5">
    <div class="card shadow border-danger mx-auto" style="max-width: 600px;">
        <div class="card-body text-center p-5">
            <h2 class="text-danger mb-4">This Trip is Full!</h2>
            <p class="lead">
                Unfortunately, there are no rooms left for the trip to <strong>@Model.Destination</strong>.
            </p>
            <p>Would you like to join the waiting list? We'll let you know if a spot opens up.</p>

            <div class="mt-4 d-grid gap-2">
             
                <form asp-controller="Trips" asp-action="JoinWaitingList" method="post">
                    <input type="hidden" name="tripId" value="@Model.TripId" />
                    <button type="submit" class="btn btn-primary btn-lg w-100">Yes, Add me to the Waiting List</button>
                </form>

                <a asp-controller="Trips" asp-action="Index" class="btn btn-outline-secondary">No thanks, take me back</a>
            </div>
        </div>
    </div>
</div>