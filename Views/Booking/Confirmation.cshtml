@model TravelAgencyProject.Models.Booking

<div class="container mt-5 text-center">
    <div class="card shadow p-5" id="confirmation-content" style="background: white; min-width: 800px; color: black;">
        <h1 class="display-4 text-success">Booking Confirmed!</h1>
        <p class="lead">Thank you for booking with us. Your reservation is complete.</p>
        <hr />

        <div class="row text-start justify-content-center">
            <div class="col-md-6">
                <h4>Reservation Summary</h4>
                <p><strong>Order ID:</strong> #@(ViewBag.PayPalOrderId ?? Model.BookingId.ToString())</p>
                <p><strong>Total Paid:</strong> $@Model.TotalPrice</p>
                <p><strong>Date:</strong> @Model.BookingDate.ToShortDateString()</p>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a asp-action="Index" asp-controller="Trips" class="btn btn-outline-primary btn-lg">Back to Trips</a>
        <button id="download-pdf" class="btn btn-success btn-lg shadow">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF Receipt
        </button>
    </div>

    <div class="text-center mt-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 shadow">
            Back to Home Page
        </a>
    </div>
</div>

<div class="card mt-5 border-0 shadow-sm bg-light text-center">
    <div class="card-body p-5">
        <h3 class="fw-bold">How was our booking service?</h3>
        <form asp-controller="Reviews" asp-action="Create" method="post">
            <input type="hidden" name="returnTo" value="Home" />
            <div class="mb-3">
                <select name="Rating" class="form-select w-25 mx-auto border-primary" required>
                    <option value="5">★★★★★ 5 Stars</option>
                    <option value="4">★★★★ 4 Stars</option>
                    <option value="3">★★★ 3 Stars</option>
                </select>
            </div>
            <div class="mb-4">
                <textarea name="Comment" class="form-control" rows="3" placeholder="Tell us what you think..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill">Submit Feedback</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        document.getElementById('download-pdf').addEventListener('click', function () {
            var docDefinition = {
                content: [
                    { text: 'BOOKING CONFIRMATION', style: 'header', alignment: 'center' },
                    { text: 'Thank you for your reservation!', alignment: 'center', margin: [0, 0, 0, 20] },
                    {
                        table: {
                            widths: ['*', '*'],
                            body: [
                                [{ text: 'Order Summary', colSpan: 2, style: 'tableHeader' }, {}],
                                ['Order ID:', '#@Model.BookingId'],
                                ['Total Paid:', '$@Model.TotalPrice'],
                                ['Date:', '@Model.BookingDate.ToShortDateString()'],
                                ['Status:', 'CONFIRMED']
                            ]
                        }
                    }
                ],
                styles: {
                    header: { fontSize: 22, bold: true, margin: [0, 0, 0, 10] },
                    tableHeader: { bold: true, fontSize: 13, color: 'white', fillOpacity: 1, fillColor: '#198754', margin: [0, 5] }
                }
            };
            pdfMake.createPdf(docDefinition).download('Booking_Confirmation_@Model.BookingId' + '.pdf');
        });
    </script>

}