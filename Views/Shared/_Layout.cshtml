<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelAgencyProject</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TravelAgencyProject.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3 shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-engines-fill"></i> TravelAgency
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Trips" asp-action="Index">Trips</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Booking" asp-action="Index">My Bookings</a>
                        </li>

                        <li class="nav-item ms-lg-2">
                            <a class="nav-link text-dark position-relative p-2" href="#" data-bs-toggle="modal" data-bs-target="#cartModal" id="cartIcon">
                                <i class="bi bi-cart3 fs-5"></i>
                                @{
                                    var cartJson = Context.Session.GetString("Cart");
                                    var count = string.IsNullOrEmpty(cartJson) ? 0 :
                                    System.Text.Json.JsonSerializer.Deserialize<List<int>>(cartJson).Count;
                                }
                                @if (count > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge">
                                        @count
                                    </span>
                                }
                            </a>
                        </li>

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link text-danger fw-bold border border-danger rounded-pill px-3 py-1"
                                   asp-controller="Booking" asp-action="AdminWaitingList" style="font-size: 0.9rem;">
                                    Waiting Lists
                                </a>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white">
        <div class="container text-center">
            &copy; 2025 - TravelAgencyProject - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="cartModalLabel"><i class="bi bi-cart3"></i> Your Cart Summary</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="cartModalBody">
                    <div class="text-center py-3">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modalBody = document.getElementById('cartModalBody');

            function loadCart() {
                fetch('/Trips/GetCartSummary')
                    .then(r => r.text())
                    .then(html => {
                        modalBody.innerHTML = html;
                        // Attach listeners to newly created trash buttons
                        modalBody.querySelectorAll('.btn-remove').forEach(btn => {
                            btn.onclick = function() {
                                var id = this.dataset.id;
                                fetch('/Trips/RemoveFromCart/' + id, { method: 'POST' })
                                    .then(() => loadCart()); // Reload popup content after removal
                            };
                        });
                    });
            }

            document.getElementById('cartIcon').onclick = function(e) {
                e.preventDefault();
                loadCart();
            };
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
