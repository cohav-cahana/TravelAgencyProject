<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelAgency</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --primary-color: #0066ff;
            --dark-blue: #001d3d;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        /* סרגל ניווט יוקרתי */
        .navbar {
            padding: 15px 0;
            transition: all 0.3s ease;
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
        }

        .navbar-brand {
            font-size: 1.5rem;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 500;
            color: #495057 !important;
            padding: 8px 16px !important;
            transition: color 0.2s;
        }

            .nav-link:hover {
                color: var(--primary-color) !important;
            }

        .cart-wrapper {
            position: relative;
            background: #f1f3f5;
            border-radius: 12px;
            padding: 8px 12px;
            transition: all 0.2s;
        }

            .cart-wrapper:hover {
                background: #e9ecef;
            }

        #cartBadge {
            font-size: 0.65rem;
            padding: 4px 6px;
            border: 2px solid white;
        }

        .admin-waiting-btn {
            background-color: #fff0f0;
            color: #dc3545 !important;
            border: 1px solid #ffc9c9 !important;
            font-size: 0.85rem !important;
            box-shadow: 0 2px 5px rgba(220, 53, 69, 0.1);
        }

            .admin-waiting-btn:hover {
                background-color: #dc3545 !important;
                color: white !important;
            }

        footer {
            background: white !important;
            padding: 30px 0;
            font-size: 0.9rem;
            margin-top: 50px;
        }

        .modal-content {
            border: none;
            border-radius: 20px;
            box-shadow: 0 15px 50px rgba(0,0,0,0.1);
        }

        .modal-header {
            border-bottom: 1px solid #f8f9fa;
            padding: 20px 25px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light sticky-top shadow-sm border-bottom">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-airplane-engines-fill me-2"></i>TravelAgency
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Trips" asp-action="Index">Trips</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Index">My Bookings</a>
                        </li>

                        @if (Context.Session.GetString("UserId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i> Profile
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="nav-link admin-waiting-btn rounded-pill px-3"
                                   asp-controller="Booking" asp-action="AdminWaitingList">
                                    <i class="bi bi- megaphone-fill me-1"></i> Waiting Lists
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            <a class="nav-link cart-wrapper" href="#" data-bs-toggle="modal" data-bs-target="#cartModal" id="cartIcon">
                                <i class="bi bi-cart3 fs-5"></i>
                                @{
                                    var cartJson = Context.Session.GetString("Cart");
                                    var count = string.IsNullOrEmpty(cartJson) ? 0 :
                                    System.Text.Json.JsonSerializer.Deserialize<List<int>>(cartJson).Count;
                                }
                                @if (count > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger shadow-sm" id="cartBadge">
                                        @count
                                    </span>
                                }
                            </a>
                        </div>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top shadow-sm">
        <div class="container text-center">
            <p class="mb-1 text-dark fw-bold">TravelAgency Project</p>
            <span class="text-muted small">&copy; 2026 - All Rights Reserved - <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy Policy</a></span>
        </div>
    </footer>

    <div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="cartModalLabel"><i class="bi bi-cart3 me-2"></i>My Cart</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="cartModalBody">
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var modalBody = document.getElementById('cartModalBody');

            function loadCart() {
                fetch('/Trips/GetCartSummary')
                    .then(r => r.text())
                    .then(html => {
                        modalBody.innerHTML = html;
                        modalBody.querySelectorAll('.btn-remove').forEach(btn => {
                            btn.onclick = function() {
                                var id = this.dataset.id;
                                fetch('/Trips/RemoveFromCart/' + id, { method: 'POST' })
                                    .then(() => loadCart());
                            };
                        });
                    });
            }

            document.getElementById('cartIcon').onclick = function(e) {
                e.preventDefault();
                loadCart();
            };
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>