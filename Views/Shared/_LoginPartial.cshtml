@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Http


<ul class="navbar-nav">
    @if (Context.Session.GetString("Email") != null)
    {
        <li class="nav-item">
            <span class="nav-link text-dark">Hello, @Context.Session.GetString("FirstName")!</span>
        </li>

        @if (Context.Session.GetString("IsAdmin") == "true")
        {
            <li class="nav-item">
                <a class="nav-link text-dark fw-bold text-danger" asp-controller="Admin" asp-action="Index">Admin Panel</a>
            </li>
        }

        <li class="nav-item">
            <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
        </li>
    }
</ul>